~ illegal return at global scope
return

~ illegal break at global scope
break

~ illegal continue at global scope
continue

if true:
    ~ still not inside a function or loop
    return

    ~ still not inside a loop
    break

    continue

while true:
    ~ legal
    break

    ~ legal
    continue

    if true:
        ~ legal, should see the enclosing loop
        break

        ~ legal
        continue

        ~ illegal, no enclosing function
        return

fn foo():
    ~ legal
    return

fn bar():
    if true:
        ~ legal
        return

        ~ illegal, no loop
        break

        continue

    while true:
        ~ all legal
        break
        continue
        return

fn baz():
    while true:
        if true:
            ~ all legal
            break
            continue
            return

if true:
    while true:
        ~ legal because we're inside a loop
        break
        continue

        ~ illegal because we're not inside a function
        return

fn qux():
    if true:
        while true:
            if true:
                ~ all legal
                break
                continue
                return

~ illegal again
return
break
continue
