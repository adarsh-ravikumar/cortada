fn stress1() -> int:
    return 1

    if true:
        return 2

    while true:
        return 3

    if true:
        while true:
            return false      ~ bool ≠ int

    return 4.5               ~ float ≠ int

fn stress2():
    return true              ~ infer bool

    if true:
        return false

    while true:
        return true

    if true:
        while true:
            return 42         ~ int ≠ bool

    return null              ~ null ≠ bool

fn stress3():
    if true:
        return 1             ~ infer int

    while true:
        if true:
            return 2

    if true:
        while true:
            return 3.14       ~ float ≠ int

    return false             ~ bool ≠ int

fn stress4() -> float:
    if true:
        while true:
            return 1.5

    return 2                 ~ int should implicitly cast to float (if allowed)

    return true              ~ bool ≠ float

fn stress5():
    while true:
        if true:
            return null       ~ infer null

        if false:
            return null

    return 1                 ~ int ≠ null

