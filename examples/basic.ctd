fn vars:       ~ no arguments, so () not necessary
  x: int = 5   ~ declaring the variable, by defining type
  y := 5       ~ declare a variable by inferring type (int in this case)

  z = 5        ~ assigning to a variable that is undefined in current scope => Error

  x = 7        ~ assigning a value of type int to already declared x
  x = 3.14     ~ assigning a value of type float to x. this causes error
  x := 3.14    ~ shadows existing integer x. creates a new float variable, also named x

fn square (x):          ~ neither return type nor input type can be inferred, not enough context 
  return x ** 2

fn square (x: int) -> int:     ~ this definition is correct
  return x ** 2

fn square (x: float) -> int:   ~ this is a method overload, dispatcher decides during compile time
  return x ** 2                ~ return type not int, so compiler shall scream at you


type t = int | float | string  ~ types work like macros, where in they are just replaced.

fn add_two (y: t) -> t:        ~ this will work as well, as the function does valid ops for the type of y 
  return y + 2                 ~ this won't work as integer cannot be added to string 

fn divide_two(y: t) -> t:
  return y / 2               ~ error here, string does not implement divide


fn check_age(age: float) -> string:
  if age > 15:
    return age + "no!"     ~ implicitly cast age to string

  return `You are ${age} years old, so sure you can do stuff!`


import env
fn main:
  args := env.args()

  user_input: string                        ~ variable declared here

  while true:
    user_input = input("what is thou age? ")

    status := check_age(user_input)                   ~ type implicitly casted to float, errors raised if any

    print(status)

    to_print := "too bad. you have failed!" if "no!" in status else "good"

    print(to_print)

  for i in 0..5:
    print(i ** 2)

  if true and false == true:
    print("something is broken...")

  user_input := null                       ~ attempt to shadow with null. this will break
  user_input: float
  user_input = null                        ~ this works, as we are assinging null to a float

  ~~~
    null works similar to Option in rust.
    a variable is treated as an option if any point in the program, it is set to null
    checks are similar to that in ts
  ~~~

  print(user_input? + 5)                 ~ this will terminate the program, as ? checks if null and if null, crashes


